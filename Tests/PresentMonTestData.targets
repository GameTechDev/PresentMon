<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="EnsurePresentMonAuxTestData" BeforeTargets="PrepareForBuild">
    <Exec
      Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)ensure-aux.ps1&quot; -MainRepoPath &quot;$(MSBuildThisFileDirectory).&quot;"
    />
  </Target>
</Project>
