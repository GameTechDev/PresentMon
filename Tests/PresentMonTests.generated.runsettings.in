<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by CMake and attached to the generated test projects. -->
<RunSettings>
  <RunConfiguration>
    <TargetPlatform>@PMON_PRESENTMON_TESTS_TARGET_PLATFORM@</TargetPlatform>
    <MaxCpuCount>1</MaxCpuCount>
    <EnvironmentVariables>
@PMON_PRESENTMON_TESTS_ENV_XML@
    </EnvironmentVariables>
  </RunConfiguration>

  <MSTest>
    <Parallelize>
      <Workers>1</Workers>
      <Scope>MethodLevel</Scope>
    </Parallelize>
  </MSTest>

  <GoogleTestAdapterSettings>
    <PrintTestOutput>true</PrintTestOutput>
    <TestDiscovery>
      <AdditionalTestCommandLine>@PMON_PRESENTMON_TESTS_DISCOVERY_ARGS@</AdditionalTestCommandLine>
    </TestDiscovery>
  </GoogleTestAdapterSettings>
</RunSettings>
