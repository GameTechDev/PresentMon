{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "presentmon",
  "version": "0.6.0",
  "dependencies": [
    "gtest",
    "cli11",
    "boost-interprocess",
    "boost-process",
    "boost-circular-buffer",
    "cereal",
    "nlohmann-json",
    "concurrentqueue",
    "boost-asio",
    "winreg",
    "vincentlaucsb-csv-parser",
    "vulkan-headers",
    "vulkan-loader"
  ],
  "features": {
    "presentbench2-vulkan-validation": {
      "description": "Build-local Khronos validation layer for PresentBench2",
      "dependencies": [
        "vulkan-validationlayers"
      ]
    }
  }
}
