<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>

    <!-- Each consuming MSI must define Directory Id="service_folder"
         (e.g., ProgramFiles64Folder\Intel\PresentMon\Service). -->
    <DirectoryRef Id="service_folder">

      <!-- PresentMonService.exe (key file + Windows service) -->
      <Component Id="pmon_shared_service_component"
                 Guid="{45531AC0-CEB6-4DD0-B6B6-2BAD7F6AD01E}"
                 Win64="yes"
                 SharedDllRefCount="yes"
                 NeverOverwrite="no"
                 Permanent="no">
        <File Id="pmon_shared_service_exe"
              Name="$(var.PresentMonService.TargetFileName)"
              Source="$(var.PresentMonService.TargetPath)"
              KeyPath="yes"
              Checksum="yes"
              Vital="yes" />

        <ServiceInstall Id="PmSharedServiceInstall"
                        Name="PresentMonSharedService"
                        DisplayName="PresentMon Shared Service"
                        Description="Shared PresentMon service to collect metrics and expose them to client applications."
                        Start="auto"
                        Type="ownProcess"
                        ErrorControl="normal"
                        Vital="no" />
        <!-- Remove on uninstall; startup is handled by a non-fatal hidden custom action below. -->
        <ServiceControl Id="SharedPresentMonServiceControl"
                        Name="PresentMonSharedService"
                        Remove="uninstall"
                        Wait="no" />
      </Component>

      <!-- PresentMonAPI2.dll -->
      <Component Id="present_mon_shared_dll_component"
                 Guid="{BC2D2B30-9011-48E5-8592-ACC58CEFDF17}"
                 Win64="yes"
                 SharedDllRefCount="yes"
                 NeverOverwrite="no"
                 Permanent="no">
        <File Id="present_mon_shared_api_2_dll"
              Name="$(var.PresentMonAPI2.TargetFileName)"
              Source="$(var.PresentMonAPI2.TargetPath)"
              KeyPath="yes"
              Checksum="yes"
              Vital="yes" />
      </Component>

      <!-- NVIDIA DisplayDriver TDH manifest -->
      <Component Id="pmon_nv_manifest_comp"
                 Guid="{E79E4899-46E9-45D0-965E-8ECD268C5C64}"
                 Win64="yes"
                 SharedDllRefCount="yes"
                 NeverOverwrite="no"
                 Permanent="no">
        <File Id="pmon_nv_manifest"
              Name="ddETWExternal.xml"
              Source="$(var.PresentMonService.TargetDir)ddETWExternal.xml"
              KeyPath="yes"
              Vital="yes" />
      </Component>

    </DirectoryRef>

    <!-- Crash recovery: after 2s, 15s, 60s, then 5m, start the service again, then stay stopped.
         The action is "run", not "restart". Restart does not take arguments. The failure command is
         the single string SCM runs. %1% is the failure-count placeholder SCM substitutes, the same
         placeholder the Recovery tab checkbox documents. The text in front of it is our option
         recovery-fail-count, then sc.exe start passes that through to the service.
         The command is static; the service does not rewrite it.
         The empty action (//0) is required. If the last action is run, the SCM repeats it forever.
         reset= 1800 clears the failure count after 30 minutes with no failure; it does not start the service.
         failureflag 0 counts only abnormal process death, not a clean SERVICE_STOPPED.
         sc.exe is invoked directly (WixQuietExec, no cmd) so %1% is not expanded and no console
         window is shown. [%SystemRoot] is used instead of [SystemFolder] because merge modules
         modularize directory ids inside formatted strings. -->
    <CustomAction Id="SetConfigureSharedServiceRecovery"
                  Property="ConfigureSharedServiceRecovery"
                  Value='&quot;[%SystemRoot]\System32\sc.exe&quot; failure PresentMonSharedService reset= 1800 actions= run/2000/run/15000/run/60000/run/300000//0 command= "sc.exe start PresentMonSharedService --recovery-fail-count %1%"'
                  Execute="immediate" />
    <CustomAction Id="ConfigureSharedServiceRecovery"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <CustomAction Id="SetConfigureSharedServiceRecoveryFlag"
                  Property="ConfigureSharedServiceRecoveryFlag"
                  Value='&quot;[%SystemRoot]\System32\sc.exe&quot; failureflag PresentMonSharedService 0'
                  Execute="immediate" />
    <CustomAction Id="ConfigureSharedServiceRecoveryFlag"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <!-- Start without a console window. Consumers may ship this module as one optional
         telemetry provider among many, so a start failure must not fail their install. -->
    <CustomAction Id="SetTryStartSharedService"
                  Property="TryStartSharedService"
                  Value='&quot;[%SystemRoot]\System32\sc.exe&quot; start PresentMonSharedService'
                  Execute="immediate" />
    <CustomAction Id="TryStartSharedService"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
        <!-- Configure recovery before starting the service. -->
        <Custom Action="SetConfigureSharedServiceRecovery" Before="ConfigureSharedServiceRecovery">NOT REMOVE</Custom>
        <Custom Action="SetConfigureSharedServiceRecoveryFlag" Before="ConfigureSharedServiceRecoveryFlag">NOT REMOVE</Custom>
        <Custom Action="ConfigureSharedServiceRecovery" After="InstallServices">NOT REMOVE</Custom>
        <Custom Action="ConfigureSharedServiceRecoveryFlag" After="ConfigureSharedServiceRecovery">NOT REMOVE</Custom>
        <Custom Action="SetTryStartSharedService" After="ConfigureSharedServiceRecoveryFlag">$pmon_shared_service_component=3</Custom>
        <Custom Action="TryStartSharedService" After="StartServices">$pmon_shared_service_component=3</Custom>
    </InstallExecuteSequence>

    <!-- Group that consumers reference -->
    <ComponentGroup Id="service_files">
      <ComponentRef Id="pmon_shared_service_component" />
      <ComponentRef Id="present_mon_shared_dll_component" />
      <ComponentRef Id="pmon_nv_manifest_comp" />
      <ComponentGroupRef Id="uci_dist_files" />
    </ComponentGroup>

  </Fragment>
</Wix>
